# Copy to the plugin's config dir:  cp config.env.example "$(herdr plugin config-dir layerfs)/config.env"
# "~/" is expanded. Every path below must be on a local disk (ext4/xfs/btrfs on Linux, APFS on macOS).
# Keep ONE of the two mode blocks.

# A LayerFS checkout with its native binding built (npm --prefix api install && npm --prefix api run build:native)
LAYERFS_API=~/layerfs/api

# --- docker mode (default; LayerFS main on Linux): Workspaces live in the LayerFS Sandbox container ---
# Runtime image as an exact digest:  docker image inspect -f '{{.Id}}' <image>   (needs git and a shell; see README)
LAYERFS_IMAGE=sha256:<digest>
# An existing Docker volume:  docker volume create layerfs-herdr
LAYERFS_VOLUME=layerfs-herdr
LAYERFS_DAEMON=~/layerfs/core/target/release/layerfs-daemon
# The Store inside that volume, as the host sees it (run the plugin as a user that can read it)
LAYERFS_STORE_PATH=/var/lib/docker/volumes/layerfs-herdr/_data/global/store.sqlite

# --- native mode (macOS, LayerFS PR #427 only, not in a release): Workspaces are host folders ---
# LAYERFS_SANDBOX=native
# LAYERFS_DAEMON=~/layerfs/core/target/release/layerfs-daemon
# LAYERFS_LOCAL_DIR=~/.layerfs/local
# LAYERFS_HOME=~/.layerfs/home
# LAYERFS_STORE_PATH=~/.layerfs/vol/p/global/store.sqlite

# Optional: pin the plugin's state file (default: Herdr's plugin state dir)
# LFS_STATE_DIR=~/.layerfs/herdr
