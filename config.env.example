# Copy to the plugin's config dir:  cp config.env.example "$(herdr plugin config-dir layerfs)/config.env"
# "~/" is expanded. Every path below must be on a local disk (APFS on macOS, ext4/xfs/btrfs on Linux).

# A LayerFS checkout with its native binding built (npm --prefix api install && npm --prefix api run build:native)
LAYERFS_API=~/code/layerfs/api

# --- native mode: Workspaces are host folders (macOS loopback NFS; LayerFS PR #427) ---
LAYERFS_SANDBOX=native
LAYERFS_DAEMON=~/code/layerfs/core/target/release/layerfs-daemon
LAYERFS_LOCAL_DIR=~/.layerfs/local
LAYERFS_HOME=~/.layerfs/home
LAYERFS_STORE_PATH=~/.layerfs/vol/p/global/store.sqlite

# --- docker mode (upstream main, Linux): delete LAYERFS_SANDBOX above and keep LAYERFS_API;
#     LayerFS's own defaults (LAYERFS_HOME, LAYERFS_IMAGE, ...) apply.

# Optional: pin the plugin's state file (default: Herdr's plugin state dir)
# LFS_STATE_DIR=~/.layerfs/herdr
